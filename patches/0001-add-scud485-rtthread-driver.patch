diff --git a/inc/scud_bms_rtt.hpp b/inc/scud_bms_rtt.hpp
new file mode 100644
index 0000000..de5d424
--- /dev/null
+++ b/inc/scud_bms_rtt.hpp
@@ -0,0 +1,21 @@
+#pragma once
+#include <rtdevice.h>
+#include <rtthread.h>
+#include <stdint.h>
+
+struct ScudBmsSnapshot { rt_uint16_t voltage_mv; rt_int16_t current_ma; rt_int16_t temperature_c10; rt_uint8_t soc; rt_uint32_t protect_status; rt_uint8_t valid; };
+
+class ScudBmsRtt {
+public:
+    ScudBmsRtt(const char *device_name, rt_uint32_t baudrate);
+    rt_err_t start(void);
+    rt_err_t poll_once(ScudBmsSnapshot *snapshot);
+    const ScudBmsSnapshot &snapshot(void) const { return snapshot_; }
+private:
+    static rt_uint16_t crc16(const rt_uint8_t *, rt_size_t);
+    rt_err_t query(rt_uint8_t, rt_uint8_t *, rt_size_t);
+    rt_err_t read_frame(rt_uint8_t, rt_uint8_t *, rt_size_t);
+    static void worker_entry(void *);
+    void worker(void);
+    const char *device_name_; rt_uint32_t baudrate_; rt_device_t serial_; rt_thread_t thread_; struct rt_mutex lock_; ScudBmsSnapshot snapshot_; volatile rt_bool_t running_;
+};
diff --git a/src/scud_bms_rtt.cpp b/src/scud_bms_rtt.cpp
new file mode 100644
index 0000000..415296c
--- /dev/null
+++ b/src/scud_bms_rtt.cpp
@@ -0,0 +1,12 @@
+#include "scud_bms_rtt.hpp"
+#define SCUD_HEAD 0xFE
+#define SCUD_TAIL 0xBB
+
+ScudBmsRtt::ScudBmsRtt(const char *n, rt_uint32_t b) : device_name_(n), baudrate_(b), serial_(RT_NULL), thread_(RT_NULL), snapshot_{0}, running_(RT_FALSE) { rt_mutex_init(&lock_, "scud", RT_IPC_FLAG_PRIO); }
+rt_uint16_t ScudBmsRtt::crc16(const rt_uint8_t *p, rt_size_t n) { rt_uint16_t c=0; while(n--){c=(rt_uint16_t)((c>>8)|(c<<8));c^=*p++;c^=(rt_uint16_t)((c&255)>>4);c^=(rt_uint16_t)((c<<8)<<4);c^=(rt_uint16_t)(((c&255)<<4)<<1);} return c; }
+rt_err_t ScudBmsRtt::start(void) { struct serial_configure c=RT_SERIAL_CONFIG_DEFAULT; c.baud_rate=baudrate_; serial_=rt_device_find(device_name_); if(!serial_) return -RT_ENOSYS; if(rt_device_control(serial_,RT_DEVICE_CTRL_CONFIG,&c)!=RT_EOK) return -RT_ERROR; if(rt_device_open(serial_,RT_DEVICE_FLAG_RDWR|RT_DEVICE_FLAG_INT_RX)!=RT_EOK) return -RT_ERROR; running_=RT_TRUE; thread_=rt_thread_create("scud",worker_entry,this,2048,18,10); if(!thread_) return -RT_ENOMEM; rt_thread_startup(thread_); return RT_EOK; }
+rt_err_t ScudBmsRtt::query(rt_uint8_t cmd, rt_uint8_t *out, rt_size_t len) { rt_uint8_t f[8]={SCUD_HEAD,SCUD_HEAD,cmd,1,1,0,0,SCUD_TAIL}; rt_uint16_t c=crc16(&f[2],3); f[5]=(rt_uint8_t)(c>>8); f[6]=(rt_uint8_t)c; rt_device_write(serial_,0,f,sizeof(f)); return read_frame(cmd,out,len); }
+rt_err_t ScudBmsRtt::read_frame(rt_uint8_t cmd, rt_uint8_t *out, rt_size_t len) { rt_uint8_t b,body[64],cr[2]; rt_size_t n=0; int s=0; for(;;){if(rt_device_read(serial_,0,&b,1)!=1)return -RT_ETIMEOUT; if(s==0){s=b==SCUD_HEAD?1:0;continue;} if(s==1){s=b==SCUD_HEAD?2:0;continue;} if(s==2){s=b==cmd?3:0;continue;} if(s==3){if(b!=len){s=0;continue;}n=0;s=4;continue;} if(s==4){body[n++]=b;if(n==len)s=5;continue;} if(s==5){cr[0]=b;s=6;continue;} if(s==6){cr[1]=b;s=7;continue;} if(s==7){if(b!=SCUD_TAIL)return -RT_ERROR; rt_uint8_t x[66];x[0]=cmd;x[1]=(rt_uint8_t)len;rt_memcpy(x+2,body,len);if(crc16(x,len+2)!=((cr[0]<<8)|cr[1]))return -RT_ERROR;rt_memcpy(out,body,len);return RT_EOK;}}
+}
+rt_err_t ScudBmsRtt::poll_once(ScudBmsSnapshot *out) { rt_uint8_t d[38]; if(query(0x31,d,sizeof(d))!=RT_EOK)return -RT_ERROR; rt_mutex_take(&lock_,RT_WAITING_FOREVER); snapshot_.voltage_mv=(d[0]<<8)|d[1];snapshot_.current_ma=(rt_int16_t)((d[2]<<8)|d[3]);snapshot_.temperature_c10=(rt_int16_t)((d[4]<<8)|d[5]);snapshot_.soc=d[6];snapshot_.protect_status=((rt_uint32_t)d[7]<<24)|((rt_uint32_t)d[8]<<16)|((rt_uint32_t)d[9]<<8)|d[10];snapshot_.valid=1;if(out)*out=snapshot_;rt_mutex_release(&lock_);return RT_EOK; }
+void ScudBmsRtt::worker_entry(void *p){((ScudBmsRtt*)p)->worker();} void ScudBmsRtt::worker(void){while(running_){poll_once(RT_NULL);rt_thread_mdelay(1000);}}
